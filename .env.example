# ==========================================================================
# matu 后端统一环境变量（从 Nacos DEFAULT_GROUP 下 14 份配置汇总而来）
#
# 用法：这些变量会覆盖 Nacos 配置里 ${VAR:默认值} 的占位符。
#       环境变量优先级高于所有通过 spring.config.import 导入的 Nacos 配置，
#       所以同一份 Nacos 配置可以在不同机器上跑出不同的连法。
#       没配的变量自动回落 Nacos 里的默认值，不会启动失败。
#
# 安全：这是模板。复制为 .env 后填入你自己的凭据；.env 已在 .gitignore 中，禁止提交。
# ==========================================================================

# ---------------- MySQL ----------------
# service-auth/check/course/file/info/interview/message/oj/pay/post/qa 共用
# 注意：当前原配置是 127.0.0.1，意味着 MySQL 与每个服务同机部署。
#       如果服务分散在多台机器，改成 MySQL 实际地址。
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ---------------- Redis ----------------
# 全部服务共用（业务缓存 + sa-token 登录态）。
# 各服务用不同的 database 隔离，database 号写在各自 yml 里，不在这里配置。
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TIMEOUT=

# ---------------- RabbitMQ ----------------
# service-ai、service-oj 使用
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# ---------------- Nacos ----------------
# 注册中心 / 配置中心地址（改这里记得同步改各服务 application.yml 里的 server-addr，
# 因为连 Nacos 本身的信息必须在拉到 Nacos 配置之前就有）
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
# 当前 Nacos 上的配置都发布在 group=nacos 下（不是默认的 DEFAULT_GROUP），
# 若在控制台把配置改成 DEFAULT_GROUP，这里要一起改回 DEFAULT_GROUP
NACOS_GROUP=

# ---------------- 内部共享令牌 ----------------
# 留空 = 对应功能关闭（接口拒绝所有请求）。
# 启用时必须是至少 32 位的随机值，且调用方与被调用方完全一致。
VIP_SERVICE_TOKEN=
SEARCH_SYNC_TOKEN=

# ---------------- service-ai ----------------
# 云 PostgreSQL（RAG 知识库 / pgvector）
AI_PG_HOST=
AI_PG_PORT=
AI_PG_DATABASE=
AI_PG_USERNAME=
AI_PG_PASSWORD=

# Chat 模型（DeepSeek）
AI_CHAT_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# Embedding 模型（阿里云百炼，只用于向量化，必须与 rag.embedding-dimension 一致）
AI_EMBEDDING_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# ---------------- service-file ----------------
# 阿里云 OSS
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_BUCKET_DOMAIN=
OSS_PUBLIC_DOMAIN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------------- service-search ----------------
ES_URL=
ES_INDEX=

# ---------------- service-oj ----------------
# 远程判题沙箱
OJ_SANDBOX_BASE_URL=
OJ_SANDBOX_AUTH_HEADER_VALUE=

# ---------------- service-pay ----------------
# 支付宝沙箱。下列 app-id / 密钥目前仍是占位符，接入真实支付前必须替换。
ALIPAY_APP_ID=
ALIPAY_MERCHANT_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# ==========================================================================
# 以下来自项目根 .env.example（不在 Nacos 里，属于服务启动前就必须注入的变量）
# 一并保留，保证 .env 是完整的一份。
# ==========================================================================

# 小程序端（只会进入小程序包，不含密钥）
MINI_PUBLIC_API_BASE_URL=
MINI_PUBLIC_WS_URL=
MINI_PUBLIC_ENV=
MINI_PUBLIC_WECHAT_APP_ID=
WECHAT_MINI_ENABLED=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
MINI_LOGIN_CONCURRENT=

# 后端内部安全；各用不同的随机值，至少 32 位
IDENTITY_RELAY_SECRET=
INTERNAL_SERVICE_SECRET=

# AI 发帖后自动总结和评论；该令牌必须同时注入 service-post 和 service-ai
AI_POST_INTERNAL_TOKEN=
AI_POST_COMMENT_USER_ID=

# ---------------- service-mcp ----------------
# service-ai 调用 MCP 工具服务的共享令牌；必须与 service-ai.yml 里
# ai.mcp.servers[].api-key 完全一致。留空会让 service-mcp 启动失败。
MCP_SERVICE_TOKEN=

# 博查 Web Search API Key；service-mcp 的 web_search 工具读取。
# 在 https://open.bochaai.com 注册获取后填入。留空则搜索工具返回"未配置搜索服务密钥"。
BOCHA_API_KEY=
